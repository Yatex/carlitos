<% content_for :title, "Briefing diario — Carlitos" %>

<%= render "shared/app_header" %>

<main class="mx-auto max-w-3xl px-5 py-10 sm:px-6 lg:px-8">
  <h1 class="text-4xl font-black text-ink">Briefing diario</h1>
  <p class="mt-3 text-muted">Elegí si querés que Carlitos te resuma lo importante cada mañana.</p>

  <section class="mt-8 rounded-lg border border-line bg-white/80 p-6 shadow-card">
    <%= form_with model: @daily_briefing, url: daily_briefing_path, method: :patch, class: "space-y-5" do |form| %>
      <label class="flex items-center gap-3 text-sm font-bold text-ink">
        <%= form.check_box :enabled, class: "h-5 w-5 rounded border-line text-ocean" %>
        Activar briefing diario
      </label>
      <div>
        <%= form.label :delivery_time, "Hora de entrega", class: "block text-sm font-black text-ink" %>
        <%= form.time_field :delivery_time, class: "mt-2 w-full rounded-lg border border-line bg-cream px-4 py-3" %>
      </div>
      <div>
        <%= form.label :timezone, "Zona horaria", class: "block text-sm font-black text-ink" %>
        <%= form.select :timezone, iana_time_zone_options(@daily_briefing.timezone), {}, class: "mt-2 w-full rounded-lg border border-line bg-cream px-4 py-3" %>
      </div>
      <%= form.submit "Guardar briefing", class: "cursor-pointer rounded-full bg-ocean px-6 py-3 font-extrabold text-white" %>
    <% end %>
  </section>
</main>
