<% content_for :title, "Billing — Carlitos" %>

<%= render "shared/app_header" %>

<main class="mx-auto max-w-7xl px-5 py-10 sm:px-6 lg:px-8">
  <section class="grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
    <div>
      <p class="text-sm font-black uppercase text-ocean">Billing</p>
      <h1 class="mt-2 text-4xl font-black text-ink sm:text-5xl">Elegí cuánto querés que Carlitos recuerde por vos.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">Tenés 14 días para probar Carlitos. Después podés pasar a Pro cuando ya sea parte de tu día, o dejar listo Family / Team para coordinar memoria compartida más adelante.</p>
    </div>

    <article class="rounded-lg border border-line bg-ink p-6 text-white shadow-soft">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="text-sm font-black uppercase text-sun">Plan actual</p>
          <p class="mt-3 text-4xl font-black"><%= @current_plan.name %></p>
          <p class="mt-2 text-sm text-white/70">Estado: <%= current_user.subscription_status %></p>
          <% if current_user.free_trial_active? %>
            <p class="mt-2 text-sm text-white/70">Trial activo: <%= current_user.trial_days_remaining %> días restantes.</p>
          <% elsif current_user.free_trial_expired? %>
            <p class="mt-2 text-sm text-sun">Tu trial gratis terminó.</p>
          <% elsif current_user.plan_expires_at.present? %>
            <p class="mt-2 text-sm text-white/70">Acceso hasta <%= l(current_user.plan_expires_at.to_date, format: :default) %>.</p>
          <% end %>
        </div>
        <span class="rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-extrabold"><%= @current_plan.price %></span>
      </div>

      <% if current_user.stripe_customer_id.present? %>
        <%= button_to "Abrir portal de Stripe", stripe_portal_path, method: :post, class: "mt-6 rounded-full bg-white px-5 py-3 font-extrabold text-ink transition hover:bg-sun" %>
      <% else %>
        <p class="mt-6 text-sm leading-6 text-white/70">El portal de Stripe aparece después del primer checkout. Mientras tanto podés elegir un plan abajo.</p>
      <% end %>
    </article>
  </section>

  <section class="mt-10 grid gap-5 lg:grid-cols-3">
    <% @plans.each do |plan| %>
      <% current = current_user.current_plan == plan.key %>
      <article class="flex min-h-full flex-col rounded-lg border <%= plan.recommended ? "border-ocean bg-white shadow-soft" : "border-line bg-white/75 shadow-card" %> p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-sm font-black uppercase <%= plan.recommended ? "text-ocean" : "text-muted" %>"><%= plan.badge %></p>
            <h2 class="mt-2 text-2xl font-black text-ink"><%= plan.name %></h2>
          </div>
          <% if current %>
            <span class="rounded-full bg-mint/10 px-3 py-1 text-xs font-black uppercase text-mint">Actual</span>
          <% end %>
        </div>

        <p class="mt-5 text-4xl font-black text-ink"><%= plan.price %></p>
        <p class="mt-3 min-h-20 leading-7 text-muted"><%= plan.description %></p>

        <ul class="mt-6 space-y-3 text-sm leading-6 text-ink">
          <% plan.features.each do |feature| %>
            <li class="flex gap-3">
              <span class="mt-1.5 h-2 w-2 flex-none rounded-full bg-mint"></span>
              <span><%= feature %></span>
            </li>
          <% end %>
        </ul>

        <% if plan.limits.any? %>
          <ul class="mt-5 space-y-2 text-sm leading-6 text-muted">
            <% plan.limits.each do |limit| %>
              <li class="flex gap-3">
                <span class="mt-1.5 h-2 w-2 flex-none rounded-full bg-line"></span>
                <span><%= limit %></span>
              </li>
            <% end %>
          </ul>
        <% end %>

        <div class="mt-auto pt-7">
          <% if current && current_user.free_trial_expired? %>
            <span class="inline-flex w-full justify-center rounded-full border border-sun/40 bg-sun/20 px-5 py-3 font-extrabold text-ink">Trial vencido</span>
          <% elsif current %>
            <span class="inline-flex w-full justify-center rounded-full border border-line bg-cream px-5 py-3 font-extrabold text-ink">Tu plan actual</span>
          <% elsif plan.configured_for_checkout? %>
            <%= button_to "Elegir #{plan.name}", stripe_checkout_path(plan: plan.key), method: :post, class: "w-full rounded-full bg-ocean px-5 py-3 font-extrabold text-white shadow-card transition hover:bg-ink" %>
          <% elsif plan.checkoutable? %>
            <span class="inline-flex w-full justify-center rounded-full border border-line bg-cream px-5 py-3 text-center font-extrabold text-muted"><%= plan.stripe_price_env %> pendiente</span>
          <% elsif plan.coming_soon %>
            <span class="inline-flex w-full justify-center rounded-full border border-line bg-cream px-5 py-3 font-extrabold text-muted">Unirme a la lista</span>
          <% elsif plan.key == "free" %>
            <span class="inline-flex w-full justify-center rounded-full border border-line bg-cream px-5 py-3 font-extrabold text-muted">Trial inicial</span>
          <% else %>
            <span class="inline-flex w-full justify-center rounded-full border border-line bg-cream px-5 py-3 font-extrabold text-ink">Incluido</span>
          <% end %>
        </div>
      </article>
    <% end %>
  </section>

  <section class="mt-10 rounded-lg border border-line bg-white/70 p-6 shadow-card">
    <h2 class="text-2xl font-black text-ink">Cómo se desbloquean funciones</h2>
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      <div class="rounded-lg bg-cream p-4">
        <p class="font-black text-ink">Free</p>
        <p class="mt-2 text-sm leading-6 text-muted">Es una prueba automática de 14 días para probar captura rápida, listas simples y recordatorios puntuales.</p>
      </div>
      <div class="rounded-lg bg-ocean/10 p-4">
        <p class="font-black text-ink">Pro</p>
        <p class="mt-2 text-sm leading-6 text-muted">Activa memoria buscable, notas de voz, briefing diario e integraciones útiles.</p>
      </div>
      <div class="rounded-lg bg-sun/20 p-4">
        <p class="font-black text-ink">Family / Team</p>
        <p class="mt-2 text-sm leading-6 text-muted">Preparado para listas, recordatorios y contexto compartido cuando esté disponible.</p>
      </div>
    </div>
    <p class="mt-5 text-sm text-muted">Stripe Checkout usa variables de entorno para los Price IDs. No hay precios reales ni credenciales hardcodeadas en el código.</p>
  </section>
</main>
