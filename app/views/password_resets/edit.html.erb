<% content_for :title, t("password_resets.edit_title") %>

<%= render "shared/public_header" %>

<main class="mx-auto grid min-h-[calc(100vh-80px)] max-w-5xl items-center px-5 py-16 sm:px-6 lg:px-8">
  <section class="mx-auto w-full max-w-lg rounded-lg border border-line bg-white/80 p-6 shadow-soft sm:p-8">
    <p class="text-sm font-black uppercase text-ocean"><%= t("password_resets.new_password_eyebrow") %></p>
    <h1 class="mt-3 text-3xl font-black text-ink"><%= t("password_resets.new_password_headline") %></h1>

    <%= form_with model: @user, url: password_reset_path(params[:token]), method: :patch, class: "mt-8 space-y-5" do |form| %>
      <% if @user.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800">
          <%= @user.errors.full_messages.to_sentence %>
        </div>
      <% end %>
      <div>
        <%= form.label :password, t("password_resets.new_password"), class: "block text-sm font-black text-ink" %>
        <%= form.password_field :password, required: true, class: "mt-2 w-full rounded-lg border border-line bg-cream px-4 py-4 outline-none focus:border-ocean focus:ring-4 focus:ring-ocean/10" %>
      </div>
      <div>
        <%= form.label :password_confirmation, t("auth.password_confirmation"), class: "block text-sm font-black text-ink" %>
        <%= form.password_field :password_confirmation, required: true, class: "mt-2 w-full rounded-lg border border-line bg-cream px-4 py-4 outline-none focus:border-ocean focus:ring-4 focus:ring-ocean/10" %>
      </div>
      <%= form.submit t("password_resets.update"), class: "w-full cursor-pointer rounded-full bg-ocean px-6 py-4 font-extrabold text-white shadow-card transition hover:bg-ink" %>
    <% end %>
  </section>
</main>
