<% content_for :title, "Recuperar contraseña — Carlitos" %>

<%= render "shared/public_header" %>

<main class="mx-auto grid min-h-[calc(100vh-80px)] max-w-5xl items-center px-5 py-16 sm:px-6 lg:px-8">
  <section class="mx-auto w-full max-w-lg rounded-lg border border-line bg-white/80 p-6 shadow-soft sm:p-8">
    <p class="text-sm font-black uppercase text-ocean">Recuperar acceso</p>
    <h1 class="mt-3 text-3xl font-black text-ink">Te mandamos un enlace</h1>
    <p class="mt-3 leading-7 text-muted">Ingresá tu email y, si existe una cuenta, te enviamos instrucciones.</p>

    <%= form_with url: password_resets_path, class: "mt-8 space-y-5" do |form| %>
      <div>
        <%= form.label :email, "Email", class: "block text-sm font-black text-ink" %>
        <%= form.email_field :email, required: true, class: "mt-2 w-full rounded-lg border border-line bg-cream px-4 py-4 outline-none focus:border-ocean focus:ring-4 focus:ring-ocean/10" %>
      </div>
      <%= form.submit "Enviar instrucciones", class: "w-full cursor-pointer rounded-full bg-ocean px-6 py-4 font-extrabold text-white shadow-card transition hover:bg-ink" %>
    <% end %>
  </section>
</main>
