<% content_for :title, t("admin.analytics_title") %>

<%= render "shared/app_header" %>

<main class="mx-auto max-w-7xl px-5 py-10 sm:px-6 lg:px-8">
  <section class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-black uppercase text-ocean"><%= t("admin.eyebrow") %></p>
      <h1 class="mt-2 text-4xl font-black text-ink"><%= t("admin.analytics_heading") %></h1>
      <p class="mt-3 max-w-2xl leading-7 text-muted"><%= t("admin.analytics_description") %></p>
    </div>
    <%= link_to t("admin.manage_users"), admin_users_path, class: "inline-flex rounded-full bg-ink px-5 py-3 text-sm font-extrabold text-white shadow-card transition hover:bg-ocean" %>
  </section>

  <section class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <% [
      [t("admin.total_users"), @stats[:total_users], t("admin.total_users_hint")],
      [t("admin.paying_users"), @stats[:paying_users], t("admin.paying_users_hint")],
      [t("admin.active_trials"), @stats[:active_free_trials], t("admin.active_trials_hint")],
      [t("admin.expired_trials"), @stats[:expired_free_trials], t("admin.expired_trials_hint")],
      [t("admin.early_access"), @stats[:early_access_signups], t("admin.early_access_hint")],
      [t("admin.admins"), @stats[:admin_users], t("admin.admins_hint")]
    ].each do |label, value, hint| %>
      <article class="rounded-lg border border-line bg-white/80 p-5 shadow-card">
        <p class="text-xs font-black uppercase text-muted"><%= label %></p>
        <p class="mt-3 text-4xl font-black text-ink"><%= number_with_delimiter(value) %></p>
        <p class="mt-2 text-sm text-muted"><%= hint %></p>
      </article>
    <% end %>
  </section>

  <section class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <% [
      [t("admin.reminders"), @stats[:reminders]],
      [t("admin.lists"), @stats[:memory_lists]],
      [t("admin.notes"), @stats[:memory_notes]],
      [t("admin.assistant_messages"), @stats[:assistant_messages]],
      [t("admin.active_briefings"), @stats[:enabled_daily_briefings]],
      [t("admin.whatsapp_connected"), @stats[:whatsapp_connections]],
      [t("admin.gmail_connected"), @stats[:gmail_connections]],
      [t("admin.calendar_connected"), @stats[:calendar_connections]]
    ].each do |label, value| %>
      <article class="rounded-lg border border-line bg-cream p-5">
        <p class="text-sm font-extrabold text-muted"><%= label %></p>
        <p class="mt-2 text-3xl font-black text-ink"><%= number_with_delimiter(value) %></p>
      </article>
    <% end %>
  </section>

  <section class="mt-8 grid gap-6 lg:grid-cols-3">
    <article class="rounded-lg border border-line bg-white/80 p-5 shadow-card">
      <h2 class="text-xl font-black text-ink"><%= t("admin.users_by_plan") %></h2>
      <div class="mt-5 space-y-3">
        <% @plans.each do |plan| %>
          <% count = @stats[:users_by_plan][plan.key] || 0 %>
          <div class="flex items-center justify-between gap-4 rounded-lg bg-cream px-4 py-3">
            <span class="font-extrabold text-ink"><%= plan.name %></span>
            <span class="text-muted"><%= number_with_delimiter(count) %></span>
          </div>
        <% end %>
      </div>
    </article>

    <article class="rounded-lg border border-line bg-white/80 p-5 shadow-card">
      <h2 class="text-xl font-black text-ink"><%= t("admin.subscription_statuses") %></h2>
      <div class="mt-5 space-y-3">
        <% User::SUBSCRIPTION_STATUSES.each do |status| %>
          <% count = @stats[:users_by_subscription_status][status] || 0 %>
          <div class="flex items-center justify-between gap-4 rounded-lg bg-cream px-4 py-3">
            <span class="font-extrabold text-ink"><%= localized_status(status) %></span>
            <span class="text-muted"><%= number_with_delimiter(count) %></span>
          </div>
        <% end %>
      </div>
    </article>

    <article class="rounded-lg border border-line bg-white/80 p-5 shadow-card">
      <h2 class="text-xl font-black text-ink"><%= t("admin.roles") %></h2>
      <div class="mt-5 space-y-3">
        <% User.roles.keys.each do |role| %>
          <% count = @stats[:users_by_role][role] || 0 %>
          <div class="flex items-center justify-between gap-4 rounded-lg bg-cream px-4 py-3">
            <span class="font-extrabold text-ink"><%= localized_role(role) %></span>
            <span class="text-muted"><%= number_with_delimiter(count) %></span>
          </div>
        <% end %>
      </div>
    </article>
  </section>

  <section class="mt-8 rounded-lg border border-line bg-white/80 p-5 shadow-card">
    <h2 class="text-xl font-black text-ink"><%= t("admin.latest_users") %></h2>
    <div class="mt-5 overflow-x-auto">
      <table class="w-full min-w-[720px] text-left text-sm">
        <thead class="bg-cream text-xs font-black uppercase text-muted">
          <tr>
            <th class="px-4 py-3"><%= t("admin.user") %></th>
            <th class="px-4 py-3"><%= t("admin.role") %></th>
            <th class="px-4 py-3"><%= t("admin.plan") %></th>
            <th class="px-4 py-3"><%= t("admin.joined_label") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% @stats[:recent_users].each do |user| %>
            <tr>
              <td class="px-4 py-4">
                <p class="font-extrabold text-ink"><%= user.email %></p>
                <p class="text-muted"><%= user.display_name %></p>
              </td>
              <td class="px-4 py-4 text-muted"><%= localized_role(user.role) %></td>
              <td class="px-4 py-4 text-muted"><%= (Billing::PlanCatalog.find(user.current_plan) || Billing::PlanCatalog.find!("free")).name %> · <%= localized_status(user.subscription_status) %></td>
              <td class="px-4 py-4 text-muted"><%= l(user.created_at.to_date, format: :default) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</main>
