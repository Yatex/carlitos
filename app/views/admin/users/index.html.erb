<% content_for :title, t("admin.users_title") %>

<%= render "shared/app_header" %>

<main class="mx-auto max-w-7xl px-5 py-10 sm:px-6 lg:px-8">
  <section class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-black uppercase text-ocean"><%= t("admin.eyebrow") %></p>
      <h1 class="mt-2 text-4xl font-black text-ink"><%= t("admin.users_heading") %></h1>
      <p class="mt-3 max-w-2xl leading-7 text-muted"><%= t("admin.users_description") %></p>
    </div>
    <%= link_to t("admin.view_analytics"), admin_analytics_path, class: "inline-flex rounded-full bg-ink px-5 py-3 text-sm font-extrabold text-white shadow-card transition hover:bg-ocean" %>
  </section>

  <section class="mt-8 rounded-lg border border-line bg-white/75 p-5 shadow-card">
    <%= form_with url: admin_users_path, method: :get, class: "grid gap-4 md:grid-cols-5" do |form| %>
      <div class="md:col-span-2">
        <%= form.label :email, t("admin.email"), class: "block text-xs font-black uppercase text-muted" %>
        <%= form.email_field :email, value: params[:email], placeholder: t("admin.email_placeholder"), class: "mt-2 w-full rounded-lg border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-ocean focus:ring-4 focus:ring-ocean/10" %>
      </div>
      <div>
        <%= form.label :role, t("admin.role"), class: "block text-xs font-black uppercase text-muted" %>
        <%= form.select :role, options_for_select([[t("admin.all"), ""]] + User.roles.keys.map { |role| [localized_role(role), role] }, params[:role]), {}, class: "mt-2 w-full rounded-lg border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-ocean focus:ring-4 focus:ring-ocean/10" %>
      </div>
      <div>
        <%= form.label :plan, t("admin.plan"), class: "block text-xs font-black uppercase text-muted" %>
        <%= form.select :plan, options_for_select([[t("admin.all"), ""]] + @plans.map { |plan| [plan.name, plan.key] }, params[:plan]), {}, class: "mt-2 w-full rounded-lg border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-ocean focus:ring-4 focus:ring-ocean/10" %>
      </div>
      <div class="flex items-end">
        <%= form.submit t("admin.filter"), class: "w-full rounded-full bg-ocean px-5 py-3 text-sm font-extrabold text-white shadow-card transition hover:bg-ink" %>
      </div>
    <% end %>
  </section>

  <section class="mt-6 overflow-hidden rounded-lg border border-line bg-white/80 shadow-card">
    <div class="border-b border-line px-5 py-4">
      <p class="text-sm font-extrabold text-ink"><%= t("admin.total_users_count", count: number_with_delimiter(@total_count)) %></p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[980px] text-left text-sm">
        <thead class="bg-cream text-xs font-black uppercase text-muted">
          <tr>
            <th class="px-5 py-4"><%= t("admin.user") %></th>
            <th class="px-5 py-4"><%= t("admin.role") %></th>
            <th class="px-5 py-4"><%= t("admin.plan") %></th>
            <th class="px-5 py-4"><%= t("admin.usage") %></th>
            <th class="px-5 py-4"><%= t("admin.extend_plan") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% @users.each do |user| %>
            <% current_plan = Billing::PlanCatalog.find(user.current_plan) || Billing::PlanCatalog.find!("free") %>
            <tr class="align-top">
              <td class="px-5 py-5">
                <p class="font-extrabold text-ink"><%= user.display_name %></p>
                <p class="mt-1 text-muted"><%= user.email %></p>
                <p class="mt-2 text-xs text-muted"><%= t("admin.joined", date: l(user.created_at.to_date, format: :default)) %></p>
              </td>

              <td class="px-5 py-5">
                <% if current_user.super_admin? && user != current_user && !user.super_admin? %>
                  <%= form_with url: update_role_admin_user_path(user), method: :patch, class: "inline-flex min-w-36" do |form| %>
                    <%= form.select :role, options_for_select(User.roles.keys.map { |role| [localized_role(role), role] }, user.role), {}, onchange: "this.form.requestSubmit()", class: "w-full rounded-lg border border-line bg-white px-3 py-2 text-sm font-bold text-ink outline-none transition focus:border-ocean focus:ring-4 focus:ring-ocean/10" %>
                  <% end %>
                <% else %>
                  <span class="inline-flex rounded-full bg-ink px-3 py-1 text-xs font-black uppercase text-white"><%= localized_role(user.role) %></span>
                <% end %>
              </td>

              <td class="px-5 py-5">
                <div class="flex flex-col gap-2">
                  <span class="inline-flex w-fit rounded-full bg-ocean/10 px-3 py-1 text-xs font-black uppercase text-ocean"><%= current_plan.name %></span>
                  <span class="text-sm text-muted"><%= t("admin.status", status: localized_status(user.subscription_status)) %></span>
                  <% if user.plan_expires_at.present? %>
                    <span class="text-sm <%= user.plan_access_active? ? "text-muted" : "text-red-700" %>"><%= t("admin.access_until", date: l(user.plan_expires_at.to_date, format: :default)) %></span>
                  <% else %>
                    <span class="text-sm text-muted"><%= t("admin.no_manual_expiration") %></span>
                  <% end %>
                  <% if user.plan_granted_by.present? %>
                    <span class="text-xs text-muted"><%= t("admin.granted_by", email: user.plan_granted_by.email) %></span>
                  <% end %>
                </div>
              </td>

              <td class="px-5 py-5">
                <div class="grid grid-cols-2 gap-2 text-xs text-muted">
                  <span><strong class="text-ink"><%= user.reminders.count %></strong> <%= t("admin.reminders").downcase %></span>
                  <span><strong class="text-ink"><%= user.memory_lists.count %></strong> <%= t("admin.lists").downcase %></span>
                  <span><strong class="text-ink"><%= user.memory_notes.count %></strong> <%= t("admin.notes").downcase %></span>
                  <span><strong class="text-ink"><%= user.assistant_messages.count %></strong> <%= t("admin.assistant_messages").downcase %></span>
                </div>
              </td>

              <td class="px-5 py-5">
                <% if current_user.super_admin? || !user.super_admin? %>
                  <% default_date = user.plan_expires_at&.future? ? user.plan_expires_at.to_date : 1.month.from_now.to_date %>
                  <%= form_with url: extend_plan_admin_user_path(user), method: :patch, class: "grid min-w-72 gap-3 sm:grid-cols-[1fr_1fr_auto]" do |form| %>
                    <%= form.select :current_plan, options_for_select(@grantable_plans.map { |plan| [plan.name, plan.key] }, user.current_plan), {}, class: "rounded-lg border border-line bg-white px-3 py-2 text-sm text-ink outline-none transition focus:border-ocean focus:ring-4 focus:ring-ocean/10" %>
                    <%= form.date_field :plan_expires_on, value: default_date, min: Date.current, class: "rounded-lg border border-line bg-white px-3 py-2 text-sm text-ink outline-none transition focus:border-ocean focus:ring-4 focus:ring-ocean/10" %>
                    <%= form.submit t("admin.save"), class: "rounded-full bg-ocean px-4 py-2 text-sm font-extrabold text-white transition hover:bg-ink" %>
                  <% end %>
                <% else %>
                  <p class="text-sm text-muted"><%= t("admin.no_manual_super_admin") %></p>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @total_pages > 1 %>
      <div class="flex items-center justify-between border-t border-line px-5 py-4">
        <p class="text-sm text-muted"><%= t("admin.page", page: @page, pages: @total_pages) %></p>
        <div class="flex gap-2">
          <% if @page > 1 %>
            <%= link_to t("admin.previous"), admin_users_path(request.query_parameters.merge(page: @page - 1)), class: "rounded-full border border-line bg-white px-4 py-2 text-sm font-bold text-ink transition hover:text-ocean" %>
          <% end %>
          <% if @page < @total_pages %>
            <%= link_to t("admin.next"), admin_users_path(request.query_parameters.merge(page: @page + 1)), class: "rounded-full border border-line bg-white px-4 py-2 text-sm font-bold text-ink transition hover:text-ocean" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
</main>
