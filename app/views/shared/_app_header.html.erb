<header class="border-b border-line bg-white/75 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 py-4 sm:px-6 lg:px-8">
    <%= link_to dashboard_path, class: "flex items-center gap-3" do %>
      <%= image_tag "carlitos-mark.svg", alt: "Carlitos", class: "h-10 w-10 rounded-lg shadow-card" %>
      <span class="text-xl font-black text-ink">Carlitos</span>
    <% end %>

    <div class="hidden items-center gap-6 text-sm md:flex">
      <%= nav_link_to "Dashboard", dashboard_path %>
      <%= nav_link_to "Recordatorios", reminders_path %>
      <%= nav_link_to "Listas", memory_lists_path %>
      <%= nav_link_to "Memoria", memory_notes_path %>
    </div>

    <div class="flex items-center gap-3">
      <details class="relative">
        <summary class="flex cursor-pointer list-none items-center gap-3 rounded-full border border-line bg-white px-4 py-2 text-sm font-bold text-ink shadow-card transition hover:text-ocean">
          <span class="grid h-8 w-8 place-items-center rounded-full bg-ocean/10 text-xs font-black uppercase text-ocean"><%= current_user.display_name.first %></span>
          <span class="hidden max-w-[9rem] truncate sm:inline"><%= current_user.display_name %></span>
        </summary>

        <div class="absolute right-0 top-12 z-50 min-w-[14rem] overflow-hidden rounded-lg border border-line bg-white shadow-soft">
          <div class="border-b border-line px-4 py-3">
            <p class="truncate text-sm font-black text-ink"><%= current_user.display_name %></p>
            <p class="truncate text-xs text-muted"><%= current_user.email %></p>
          </div>
          <div class="p-2">
            <%= link_to "Billing", billing_path, class: "block rounded-lg px-3 py-2 text-sm font-bold text-ink transition hover:bg-cream hover:text-ocean" %>
            <%= link_to "Ajustes", settings_path, class: "block rounded-lg px-3 py-2 text-sm font-bold text-ink transition hover:bg-cream hover:text-ocean" %>
            <%= link_to "Cuenta", edit_account_path, class: "block rounded-lg px-3 py-2 text-sm font-bold text-ink transition hover:bg-cream hover:text-ocean" %>
            <% if current_user.admin_like? %>
              <div class="my-2 h-px bg-line"></div>
              <p class="px-3 py-1 text-[11px] font-black uppercase text-muted">Admin</p>
              <%= link_to "Usuarios", admin_users_path, class: "block rounded-lg px-3 py-2 text-sm font-bold text-ink transition hover:bg-cream hover:text-ocean" %>
              <%= link_to "Estadísticas", admin_analytics_path, class: "block rounded-lg px-3 py-2 text-sm font-bold text-ink transition hover:bg-cream hover:text-ocean" %>
            <% end %>
            <div class="my-2 h-px bg-line"></div>
            <%= button_to "Salir", logout_path, method: :delete, class: "w-full rounded-lg px-3 py-2 text-left text-sm font-bold text-red-700 transition hover:bg-red-50" %>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>
