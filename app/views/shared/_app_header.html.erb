<header class="border-b border-line bg-white/75 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 py-4 sm:px-6 lg:px-8">
    <%= link_to dashboard_path, class: "flex items-center gap-3" do %>
      <span class="grid h-10 w-10 place-items-center rounded-lg bg-ink text-base font-black text-white shadow-card">C</span>
      <span class="text-xl font-black text-ink">Carlitos</span>
    <% end %>

    <div class="hidden items-center gap-6 text-sm md:flex">
      <%= nav_link_to "Dashboard", dashboard_path %>
      <%= nav_link_to "Recordatorios", reminders_path %>
      <%= nav_link_to "Listas", memory_lists_path %>
      <%= nav_link_to "Memoria", memory_notes_path %>
      <%= nav_link_to "Billing", billing_path %>
      <%= nav_link_to "Ajustes", settings_path %>
      <% if current_user.admin_like? %>
        <%= nav_link_to "Usuarios", admin_users_path %>
        <%= nav_link_to "Estadísticas", admin_analytics_path %>
      <% end %>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to "Settings", settings_path, class: "hidden rounded-full border border-line bg-white px-4 py-2 text-sm font-bold text-ink shadow-card transition hover:text-ocean sm:inline-flex" %>
      <%= button_to "Salir", logout_path, method: :delete, class: "rounded-full bg-ink px-4 py-2 text-sm font-bold text-white shadow-card transition hover:bg-ocean" %>
    </div>
  </nav>
</header>
