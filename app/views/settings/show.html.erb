<% content_for :title, t("settings.title") %>

<%= render "shared/app_header" %>

<main class="mx-auto max-w-7xl px-5 py-10 sm:px-6 lg:px-8">
  <section class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="text-sm font-black uppercase text-ocean"><%= t("settings.eyebrow") %></p>
      <h1 class="mt-2 text-4xl font-black leading-tight text-ink sm:text-5xl"><%= t("settings.headline") %></h1>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-muted">
        <%= t("settings.subtitle") %>
      </p>
    </div>

    <article class="rounded-lg border border-line bg-white/80 p-6 shadow-card">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-black uppercase text-mint"><%= t("settings.account") %></p>
          <h2 class="mt-2 text-2xl font-black text-ink"><%= current_user.display_name %></h2>
          <p class="mt-1 text-muted"><%= current_user.email %> · <%= current_user.timezone %></p>
        </div>
        <%= link_to t("buttons.edit_account"), edit_account_path, class: "inline-flex justify-center rounded-full border border-line bg-white px-5 py-3 font-extrabold text-ink shadow-card transition hover:text-ocean" %>
      </div>
    </article>
  </section>

  <section class="mt-8 grid gap-6 lg:grid-cols-3">
    <% @integration_cards.each do |card| %>
      <% connection = card[:connection] %>
      <article class="rounded-lg border border-line bg-white/82 p-6 shadow-card">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-sm font-black uppercase text-ocean"><%= card[:short_name] %></p>
            <h2 class="mt-2 text-2xl font-black text-ink"><%= card[:name] %></h2>
          </div>
          <% status_classes = {
            "connected" => "bg-mint/15 text-mint",
            "pending" => "bg-sun/30 text-ink",
            "error" => "bg-red-100 text-red-700",
            "disconnected" => "bg-cream text-muted"
          } %>
          <span class="rounded-full px-3 py-1 text-xs font-black uppercase <%= status_classes.fetch(connection.status, "bg-cream text-muted") %>">
            <%= localized_integration_status(connection.status) %>
          </span>
        </div>

        <p class="mt-5 leading-7 text-muted"><%= card[:summary] %></p>
        <p class="mt-4 rounded-lg bg-cream p-4 text-sm font-semibold leading-6 text-ink"><%= card[:value] %></p>

        <% if connection.display_name.present? %>
          <p class="mt-4 text-sm text-muted"><%= t("settings.connected_as") %> <span class="font-bold text-ink"><%= connection.display_name %></span></p>
        <% end %>

        <% unless card[:configured] %>
          <p class="mt-4 rounded-lg border border-sun/40 bg-sun/20 p-3 text-sm font-semibold leading-6 text-ink">
            <%= t("settings.missing_config") %> <%= card[:env].join(", ") %>
          </p>
        <% end %>

        <% if card[:provider] == "whatsapp" %>
          <%= form_with url: connect_integration_path(provider: "whatsapp"), class: "mt-6 space-y-3" do |form| %>
            <%= form.telephone_field :phone,
                  value: connection.display_name,
                  placeholder: "+59899999999",
                  class: "w-full rounded-lg border border-line bg-cream px-4 py-3 outline-none focus:border-ocean focus:ring-4 focus:ring-ocean/10" %>
            <%= form.submit connection.connected? ? t("buttons.update_whatsapp") : t("buttons.connect_whatsapp"),
                  class: "w-full cursor-pointer rounded-full bg-ocean px-5 py-3 font-extrabold text-white shadow-card transition hover:bg-ink" %>
          <% end %>
        <% elsif connection.connected? %>
          <div class="mt-6 rounded-lg bg-cream p-4 text-sm leading-6 text-muted">
            <%= t("settings.authorized_scopes") %> <%= Array(connection.metadata["scopes"]).presence&.join(", ") || t("settings.registered") %>
          </div>
        <% else %>
          <%= button_to t("buttons.connect", name: card[:short_name]),
                connect_integration_path(provider: card[:provider]),
                method: :post,
                class: "mt-6 w-full rounded-full bg-ocean px-5 py-3 font-extrabold text-white shadow-card transition hover:bg-ink" %>
        <% end %>

        <% unless connection.disconnected? %>
          <%= button_to t("buttons.disconnect"),
                disconnect_integration_path(provider: card[:provider]),
                method: :delete,
                class: "mt-3 w-full rounded-full border border-line bg-white px-5 py-3 font-extrabold text-ink transition hover:text-ocean" %>
        <% end %>
      </article>
    <% end %>
  </section>
</main>
