<%= form_with model: signup, url: early_access_signups_path, class: "space-y-5", id: "early-access-form" do |form| %>
  <% if signup.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800">
      <%= signup.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Nombre", class: "block text-sm font-black text-ink" %>
    <%= form.text_field :name, autocomplete: "name", placeholder: "Tu nombre", class: "mt-2 w-full rounded-lg border border-line bg-cream px-4 py-4 text-ink outline-none transition placeholder:text-muted/60 focus:border-ocean focus:ring-4 focus:ring-ocean/10" %>
  </div>

  <div>
    <%= form.label :email, "Email", class: "block text-sm font-black text-ink" %>
    <%= form.email_field :email, autocomplete: "email", required: true, placeholder: "tu@email.com", class: "mt-2 w-full rounded-lg border border-line bg-cream px-4 py-4 text-ink outline-none transition placeholder:text-muted/60 focus:border-ocean focus:ring-4 focus:ring-ocean/10" %>
  </div>

  <%= form.submit "Quiero probar Carlitos", class: "w-full cursor-pointer rounded-full bg-ocean px-6 py-4 font-extrabold text-white shadow-card transition hover:-translate-y-0.5 hover:bg-ink focus:outline-none focus:ring-4 focus:ring-ocean/20" %>

  <p class="text-sm leading-6 text-muted">
    Te escribiremos cuando el acceso anticipado esté listo. Sin ruido, sin promesas raras.
  </p>
<% end %>
