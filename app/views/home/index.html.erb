<% content_for :title, t("landing.title") %>
<% content_for :description, t("landing.description") %>
<% pricing_plans = Billing::PlanCatalog.all.index_by(&:key) %>

<%= render "shared/public_header" %>

<main>
  <section class="surface-grid overflow-hidden">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 pb-20 pt-16 sm:px-6 sm:pt-20 lg:grid-cols-[0.95fr_1.05fr] lg:px-8 lg:pb-28 lg:pt-24">
      <div>
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-white/70 px-4 py-2 text-sm font-semibold text-muted shadow-card">
          <span class="h-2 w-2 rounded-full bg-mint"></span>
          <%= t("landing.hero_badge") %>
        </div>
        <h1 class="max-w-3xl text-5xl font-black leading-[1.02] text-ink sm:text-6xl lg:text-7xl">
          <%= t("landing.hero_headline") %>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted sm:text-xl">
          <%= t("landing.hero_subheadline") %>
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <%= link_to t("landing.primary_cta"), signup_path, class: "inline-flex items-center justify-center rounded-full bg-ocean px-7 py-4 text-base font-extrabold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-ink focus:outline-none focus:ring-4 focus:ring-ocean/20" %>
          <%= link_to t("landing.secondary_cta"), "#como-funciona", class: "inline-flex items-center justify-center rounded-full border border-line bg-white/80 px-7 py-4 text-base font-extrabold text-ink shadow-card transition hover:-translate-y-0.5 hover:border-ocean/40 hover:text-ocean focus:outline-none focus:ring-4 focus:ring-ocean/10" %>
        </div>
        <div class="mt-10 grid max-w-xl grid-cols-1 gap-3 text-sm text-muted sm:grid-cols-3">
          <% t("landing.stats").each do |value, label| %>
            <div class="rounded-lg border border-line bg-white/65 p-4">
              <strong class="block text-2xl text-ink"><%= value %></strong>
              <%= label %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="relative">
        <div class="relative grid gap-4 rounded-lg border border-line bg-white/75 p-4 shadow-soft backdrop-blur sm:grid-cols-2 sm:p-5">
          <section aria-label="<%= t("landing.chat_aria") %>" class="rounded-lg bg-[#eef7f2] p-4">
            <div class="mb-4 flex items-center gap-3 border-b border-mint/15 pb-3">
              <div class="grid h-10 w-10 place-items-center rounded-full bg-mint text-sm font-black text-white">C</div>
              <div>
                <p class="text-sm font-black text-ink">Carlitos</p>
                <p class="text-xs font-semibold text-mint"><%= t("landing.chat_label") %></p>
              </div>
            </div>
            <div class="space-y-4">
              <div class="chat-bubble max-w-[92%] rounded-lg bg-white p-4 text-sm font-medium leading-6 text-ink shadow-card">
                <%= t("landing.chat_1") %>
              </div>
              <div class="chat-bubble ml-auto max-w-[94%] rounded-lg bg-[#d9f5e8] p-4 text-sm font-medium leading-6 text-ink shadow-card">
                <%= t("landing.assistant_reply") %>
              </div>
              <div class="chat-bubble max-w-[92%] rounded-lg bg-white p-4 text-sm font-medium leading-6 text-ink shadow-card">
                <%= t("landing.chat_2") %>
              </div>
              <div class="chat-bubble max-w-[92%] rounded-lg bg-white p-4 text-sm font-medium leading-6 text-ink shadow-card">
                <%= t("landing.chat_3") %>
              </div>
            </div>
          </section>

          <section aria-label="<%= t("landing.organized_aria") %>" class="space-y-3 rounded-lg bg-ink p-4 text-white">
            <article class="rounded-lg bg-white/10 p-4 ring-1 ring-white/10">
              <p class="text-xs font-bold uppercase text-sun"><%= t("landing.reminder_created") %></p>
              <h2 class="mt-1 text-base font-black"><%= t("landing.reminder_title") %></h2>
              <p class="mt-2 text-sm leading-6 text-white/72"><%= t("landing.reminder_created_detail") %></p>
            </article>
            <article class="rounded-lg bg-white/10 p-4 ring-1 ring-white/10">
              <p class="text-xs font-bold uppercase text-[#8de0c3]"><%= t("landing.list_updated") %></p>
              <h2 class="mt-1 text-base font-black"><%= t("landing.grocery_title") %></h2>
              <p class="mt-2 text-sm leading-6 text-white/72"><%= t("landing.grocery_detail") %></p>
            </article>
            <article class="rounded-lg bg-white/10 p-4 ring-1 ring-white/10">
              <p class="text-xs font-bold uppercase text-[#92d8ef]"><%= t("landing.daily_briefing_scheduled") %></p>
              <h2 class="mt-1 text-base font-black"><%= t("landing.briefing_title") %></h2>
              <p class="mt-2 text-sm leading-6 text-white/72"><%= t("landing.briefing_detail") %></p>
            </article>
            <article class="rounded-lg bg-white/10 p-4 ring-1 ring-white/10">
              <p class="text-xs font-bold uppercase text-sun"><%= t("landing.context_saved") %></p>
              <h2 class="mt-1 text-base font-black"><%= t("landing.context_title") %></h2>
              <p class="mt-2 text-sm leading-6 text-white/72"><%= t("landing.context_detail") %></p>
            </article>
          </section>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-white/55 py-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-black uppercase text-ocean"><%= t("landing.problem_eyebrow") %></p>
        <h2 class="mt-4 text-3xl font-black leading-tight text-ink sm:text-5xl">
          <%= t("landing.problem_headline") %>
        </h2>
        <p class="mt-5 text-lg leading-8 text-muted">
          <%= t("landing.problem_copy") %>
        </p>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        <% [[t("landing.pain_1_title"), t("landing.pain_1_copy"), "bg-sun/30"], [t("landing.pain_2_title"), t("landing.pain_2_copy"), "bg-mint/18"], [t("landing.pain_3_title"), t("landing.pain_3_copy"), "bg-ocean/15"]].each_with_index do |(title, copy, tone), index| %>
          <article class="rounded-lg border border-line bg-cream p-6 shadow-card">
            <div class="mb-5 grid h-12 w-12 place-items-center rounded-lg <%= tone %> text-xl font-black text-ink"><%= index + 1 %></div>
            <h3 class="text-xl font-black text-ink"><%= title %></h3>
            <p class="mt-3 leading-7 text-muted"><%= copy %></p>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <section id="como-funciona" class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-black uppercase text-ocean"><%= t("landing.how_eyebrow") %></p>
        <h2 class="mt-4 text-3xl font-black leading-tight text-ink sm:text-5xl">
          <%= t("landing.how_headline") %>
        </h2>
      </div>
      <div class="mt-14 grid gap-5 lg:grid-cols-3">
        <% [[t("landing.capture_title"), t("landing.capture_copy")], [t("landing.organize_title"), t("landing.organize_copy")], [t("landing.remind_title"), t("landing.remind_copy")]].each_with_index do |(title, copy), index| %>
          <article class="rounded-lg border border-line bg-white/78 p-7 shadow-card">
            <span class="text-sm font-black text-ocean"><%= "%02d" % (index + 1) %></span>
            <h3 class="mt-4 text-2xl font-black text-ink"><%= title %></h3>
            <p class="mt-3 leading-7 text-muted"><%= copy %></p>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <section id="beneficios" class="border-y border-line bg-[#f5fbf7] py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div class="max-w-3xl">
          <p class="text-sm font-black uppercase text-mint"><%= t("landing.features_eyebrow") %></p>
          <h2 class="mt-4 text-3xl font-black leading-tight text-ink sm:text-5xl">
            <%= t("landing.features_headline") %>
          </h2>
        </div>
        <p class="max-w-xl text-lg leading-8 text-muted">
          <%= t("landing.features_copy") %>
        </p>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <% t("landing.features").each do |title, body| %>
          <article class="rounded-lg border border-line bg-white p-6 shadow-card">
            <h3 class="text-lg font-black text-ink"><%= title %></h3>
            <p class="mt-3 leading-7 text-muted"><%= body %></p>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <section id="casos" class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-black uppercase text-ocean"><%= t("landing.use_cases_eyebrow") %></p>
        <h2 class="mt-4 text-3xl font-black leading-tight text-ink sm:text-5xl">
          <%= t("landing.use_cases_headline") %>
        </h2>
      </div>
      <div class="no-scrollbar mt-12 flex gap-4 overflow-x-auto pb-3 lg:grid lg:grid-cols-5 lg:overflow-visible">
        <% t("landing.use_cases").each do |label, title, body| %>
          <article class="min-w-[16rem] rounded-lg border border-line bg-white/80 p-6 shadow-card">
            <p class="mb-4 text-sm font-black text-ocean"><%= label %></p>
            <h3 class="text-xl font-black text-ink"><%= title %></h3>
            <p class="mt-3 leading-7 text-muted"><%= body %></p>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-ink py-20 text-white sm:py-24">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:px-8">
      <div>
        <p class="text-sm font-black uppercase text-sun"><%= t("landing.clarity_eyebrow") %></p>
        <h2 class="mt-4 text-3xl font-black leading-tight sm:text-5xl">
          <%= t("landing.clarity_headline") %>
        </h2>
        <p class="mt-5 text-lg leading-8 text-white/70">
          <%= t("landing.clarity_copy") %>
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <% t("landing.principles").each do |principle| %>
          <div class="rounded-lg bg-white/8 p-5 ring-1 ring-white/10"><%= principle %></div>
        <% end %>
        <div class="rounded-lg bg-white/8 p-5 ring-1 ring-white/10 sm:col-span-2">
          <%= t("landing.clarity_footer") %>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-black uppercase text-mint"><%= t("early_access.title") %></p>
        <h2 class="mt-4 text-3xl font-black leading-tight text-ink sm:text-5xl">
          <%= t("landing.trust_1_title") %>
        </h2>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        <% [[t("landing.trust_1_title"), t("landing.trust_1_copy")], [t("landing.trust_2_title"), t("landing.trust_2_copy")], [t("landing.trust_3_title"), t("landing.trust_3_copy")]].each do |title, copy| %>
          <article class="rounded-lg border border-line bg-white/78 p-7 shadow-card">
            <p class="text-xl font-black text-ink"><%= title %></p>
            <p class="mt-3 leading-7 text-muted"><%= copy %></p>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <section id="precios" class="border-y border-line bg-white/55 py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-black uppercase text-ocean"><%= t("landing.pricing_eyebrow") %></p>
        <h2 class="mt-4 text-3xl font-black leading-tight text-ink sm:text-5xl">
          <%= t("landing.pricing_headline") %>
        </h2>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        <article class="rounded-lg border border-line bg-cream p-7 shadow-card">
          <% free_plan = pricing_plans.fetch("free") %>
          <h3 class="text-2xl font-black text-ink"><%= free_plan.name %></h3>
          <p class="mt-4 text-5xl font-black text-ink"><%= free_plan.price %></p>
          <ul class="mt-7 space-y-3 leading-7 text-muted">
            <% free_plan.features.first(4).each do |feature| %>
              <li><%= feature %></li>
            <% end %>
          </ul>
          <%= link_to t("landing.activate_trial"), signup_path, class: "mt-8 inline-flex w-full justify-center rounded-full border border-line bg-white px-5 py-3 font-extrabold text-ink transition hover:border-ocean/40 hover:text-ocean" %>
        </article>

        <article class="relative rounded-lg border-2 border-ocean bg-ink p-7 text-white shadow-soft">
          <% pro_plan = pricing_plans.fetch("pro") %>
          <span class="absolute right-6 top-6 rounded-full bg-sun px-3 py-1 text-xs font-black uppercase text-ink"><%= pro_plan.badge %></span>
          <h3 class="text-2xl font-black"><%= pro_plan.name %></h3>
          <p class="mt-4 text-5xl font-black"><%= pro_plan.price %></p>
          <ul class="mt-7 space-y-3 leading-7 text-white/72">
            <% pro_plan.features.first(7).each do |feature| %>
              <li><%= feature %></li>
            <% end %>
          </ul>
          <% if authenticated? %>
            <%= button_to t("landing.try_pro"), stripe_checkout_path(plan: "pro"), method: :post, class: "mt-8 w-full rounded-full bg-ocean px-5 py-3 font-extrabold text-white transition hover:bg-white hover:text-ink" %>
          <% else %>
            <%= link_to t("landing.try_pro"), signup_path, class: "mt-8 inline-flex w-full justify-center rounded-full bg-ocean px-5 py-3 font-extrabold text-white transition hover:bg-white hover:text-ink" %>
          <% end %>
        </article>

        <article class="rounded-lg border border-line bg-cream p-7 shadow-card">
          <% family_plan = pricing_plans.fetch("family") %>
          <h3 class="text-2xl font-black text-ink"><%= family_plan.name %></h3>
          <p class="mt-4 text-4xl font-black text-ink"><%= family_plan.price %></p>
          <ul class="mt-7 space-y-3 leading-7 text-muted">
            <% family_plan.features.first(4).each do |feature| %>
              <li><%= feature %></li>
            <% end %>
          </ul>
          <% if authenticated? %>
            <%= button_to t("landing.try_family"), stripe_checkout_path(plan: "family"), method: :post, class: "mt-8 w-full rounded-full border border-line bg-white px-5 py-3 font-extrabold text-ink transition hover:border-ocean/40 hover:text-ocean" %>
          <% else %>
            <%= link_to t("landing.try_family"), signup_path, class: "mt-8 inline-flex w-full justify-center rounded-full border border-line bg-white px-5 py-3 font-extrabold text-ink transition hover:border-ocean/40 hover:text-ocean" %>
          <% end %>
        </article>
      </div>
    </div>
  </section>

  <section id="faq" class="py-20 sm:py-24">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
      <div>
        <p class="text-sm font-black uppercase text-ocean"><%= t("landing.faq_eyebrow") %></p>
        <h2 class="mt-4 text-3xl font-black leading-tight text-ink sm:text-5xl">
          <%= t("landing.faq_headline") %>
        </h2>
      </div>
      <div class="space-y-4">
        <% t("landing.faqs").each_with_index do |(question, answer), index| %>
          <details class="group rounded-lg border border-line bg-white/78 p-5 shadow-card" <%= "open" if index.zero? %>>
            <summary class="cursor-pointer list-none text-lg font-black text-ink"><%= question %></summary>
            <p class="mt-3 leading-7 text-muted"><%= answer %></p>
          </details>
        <% end %>
      </div>
    </div>
  </section>

  <section id="early-access" class="px-5 pb-20 sm:px-6 sm:pb-24 lg:px-8">
    <div class="mx-auto grid max-w-7xl overflow-hidden rounded-lg border border-line bg-ink shadow-soft lg:grid-cols-[1fr_0.9fr]">
      <div class="p-8 text-white sm:p-12 lg:p-16">
        <p class="text-sm font-black uppercase text-sun"><%= t("early_access.title") %></p>
        <h2 class="mt-4 max-w-2xl text-4xl font-black leading-tight sm:text-6xl">
          <%= t("landing.final_headline") %>
        </h2>
        <p class="mt-5 max-w-xl text-lg leading-8 text-white/72">
          <%= t("landing.final_subheadline") %>
        </p>
        <%= link_to t("landing.final_cta"), "#early-access-form", class: "mt-8 inline-flex rounded-full bg-white px-7 py-4 font-extrabold text-ink transition hover:-translate-y-0.5 hover:bg-sun" %>
      </div>
      <div class="bg-white p-6 sm:p-8 lg:p-10">
        <%= render "early_access_form", signup: @early_access_signup %>
      </div>
    </div>
  </section>
</main>

<footer class="border-t border-line py-8">
  <div class="mx-auto flex max-w-7xl flex-col justify-between gap-4 px-5 text-sm text-muted sm:flex-row sm:items-center sm:px-6 lg:px-8">
    <p class="font-semibold text-ink">Carlitos</p>
    <p><%= t("landing.footer_line") %></p>
  </div>
</footer>
